{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=careerpilot.db;Foreign Keys=True"
  },
  "AI": {
    "Provider": "Ollama",
    "Model": "llama3.2",
    "ApiKey": ""
  },
  "MCP": {
    "Servers": {
      "Fetch": {
        "Enabled": false,
        "Command": "uvx",
        "Arguments": [ "mcp-server-fetch" ]
      },
      "Search": {
        "Enabled": false,
        "Command": "npx",
        "Arguments": [ "-y", "@modelcontextprotocol/server-brave-search" ]
      }
    }
  }
}
