{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=careerpilot.db;Foreign Keys=True"
  },
  "AI": {
    "Provider": "Ollama",
    "Model": "llama3.2",
    "ApiKey": "",
    "Providers": {
      "Ollama": {
        "Type": "Ollama",
        "ApiKey": "",
        "Model": "llama3.2",
        "Endpoint": "http://localhost:11434/v1",
        "InputCostPerMillion": 0,
        "OutputCostPerMillion": 0
      }
    },
    "TaskRouting": {
      "ProfileIngestion": "Ollama",
      "JobFitAndCascade": "Ollama",
      "ProfileInterviewer": "Ollama",
      "EvalGates": "Ollama",
      "MarketResearch": "Ollama",
      "AtsResumeGenerator": "Ollama",
      "InterviewGuide": "Ollama",
      "Fallback": "Ollama",
      "FallbackChain": [ "Ollama" ]
    }
  },
  "MCP": {
    "Servers": {
      "Fetch": {
        "Enabled": false,
        "Command": "uvx",
        "Arguments": [ "mcp-server-fetch" ]
      },
      "Search": {
        "Enabled": false,
        "Command": "npx",
        "Arguments": [ "-y", "@modelcontextprotocol/server-brave-search" ]
      }
    }
  }
}
